{
  "name": "retail-inventory-system",
  "version": "2.0.0",
  "private": true,
  "description": "Retail Inventory Management System (RIMS) - Full Stack Capstone Project",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "start": "node backend/server.js",
    "server": "node backend/server.js",
    "init-db": "npm --prefix backend run init-db",
    "test:algorithms": "node --test tests/algorithms.test.js",
    "test": "node --test tests/algorithms.test.js"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "chart.js": "^4.5.1",
    "lucide": "^1.48.0"
  },
  "devDependencies": {
    "vite": "^8.3.1"
  },
  "keywords": [
    "retail",
    "inventory",
    "management",
    "express",
    "postgresql",
    "agile",
    "capstone"
  ],
  "author": "Full Stack Capstone Team",
